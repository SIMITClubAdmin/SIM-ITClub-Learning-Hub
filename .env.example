# Copy to .env.local for local development, and set the same values in Vercel
# (Project -> Settings -> Environment Variables, for Production and Preview).

# The ITCamp Learning Hub's own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://beaoqecealnmhlsuwmap.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...). SERVER ONLY, never share.
# Needed to save quiz answers: the server grades them and writes them with this key.
SUPABASE_SECRET_KEY=

# Optional: the shared temporary password for subcomm logins (see src/lib/temporary-password.ts).
TEMPORARY_PASSWORD=
